# Argus settings. Copied to $ARGUS_HOME/config/argus.env by `./argus.sh init`.
# One KEY=value per line. No quotes, no inline comments (the container runtime
# reads this file literally). Values may contain spaces.

# ---- Dashboard and syslog listener --------------------------------------
ARGUS_HTTP_PORT=7080
ARGUS_SYSLOG=1
# 127.0.0.1 = only this Mac can send. Set to this Mac's LAN IP to accept
# syslog from routers, NAS boxes, other hosts.
ARGUS_SYSLOG_BIND=127.0.0.1
ARGUS_SYSLOG_UDP_PORT=5514
ARGUS_SYSLOG_TCP_PORT=5515
# What `argus.sh stream on` sends live from this Mac: slice (security events,
# < 1 event/s) or all (whole default-level unified log, gigabytes per day)
ARGUS_STREAM_MODE=slice
# Set to 0 by `argus.sh stream on` so CrowdSec does not see the same macOS
# events twice (live stream + 5-minute batches)
ARGUS_MACOS_TO_CROWDSEC=1

# ---- Container resources and hardening -----------------------------------
ARGUS_CPUS=2
ARGUS_MEMORY=2G
# 1 = read-only root filesystem; writes go only to /data, named volumes and tmpfs
ARGUS_READONLY_ROOT=1
# 1 = also mount /private/var/log, /Library/Logs and ~/Library/Logs read-only
ARGUS_MOUNT_HOST_LOGS=1

# ---- DNS -----------------------------------------------------------------
# Nameservers for the image builder VM (used when a build cannot resolve names)
ARGUS_BUILD_DNS=1.1.1.1 9.9.9.9
# Nameservers for the running container. Blank = runtime default (via the Mac).
# Set public resolvers if feed downloads fail with DNS errors; avoid your Pi-hole
# here, or Argus's own lookups show up in its query log and blocked threat
# domains resolve to 0.0.0.0.
ARGUS_DNS=

# ---- Collection ----------------------------------------------------------
# Root-owned drop folder the host collector writes and the container reads (read-only)
ARGUS_INBOX=/Users/Shared/Argus/inbox
# Hours of macOS events kept in the live analysis window
ARGUS_WINDOW_HOURS=24
# Days of converted logs / syslog spool kept inside the container
ARGUS_RETAIN_DAYS=7

# ---- CrowdSec (runs inside the container, detection only) -----------------
COLLECTIONS=crowdsecurity/linux crowdsecurity/iptables crowdsecurity/whitelist-good-actors
DISABLE_ONLINE_API=false
# Optional: enroll in the CrowdSec console (app.crowdsec.net)
ENROLL_KEY=
ENROLL_INSTANCE_NAME=argus
# Generated by `argus.sh init`; lets Argus read decisions + the community blocklist
BOUNCER_KEY_argus=

# ---- Pi-hole (v6 API) -----------------------------------------------------
# Blank URL = auto-detect a running container named *pihole* on the default network
PIHOLE_URL=
# Use an app password (Settings > Web interface / API > Configure app password)
PIHOLE_PASSWORD=
PIHOLE_POLL_SECONDS=120

# ---- IntelOwl ------------------------------------------------------------
# Blank = IntelOwl off. No auto-detect: set this explicitly (e.g. http://<intelowl-nginx IP>) once IntelOwl is reachable from the Argus network
INTELOWL_URL=
# IntelOwl > Account > API access > Generate token
INTELOWL_TOKEN=
INTELOWL_PLAYBOOK=FREE_TO_USE_ANALYZERS
INTELOWL_PUBLIC_URL=http://localhost:7001
# 1 = send flagged indicators automatically; 0 = manual lookups only
INTELOWL_AUTO=1
INTELOWL_DAILY_LIMIT=50

# ---- OSINT / threat-intel API keys (blank = provider off) ----------------
# abuse.ch (URLhaus, ThreatFox, Feodo): free key from https://auth.abuse.ch
ABUSECH_AUTH_KEY=
# CrowdSec CTI: free key from app.crowdsec.net > Settings > CTI API keys
CROWDSEC_CTI_KEY=
CROWDSEC_CTI_DAILY=30
ABUSEIPDB_KEY=
VT_API_KEY=
OTX_API_KEY=
GREYNOISE_KEY=

# ---- Feeds and enrichment ------------------------------------------------
# Comma-separated feed ids to turn off, e.g. blocklist_de,cins
ARGUS_FEEDS_DISABLE=
# HaGeZi TIF size: tif.mini, tif.medium or tif (the full list needs more memory)
ARGUS_HAGEZI_LIST=tif.medium
# RDAP domain-age checks per day (newly registered domain detection)
ARGUS_RDAP_DAILY=400
ARGUS_ENRICH_NEW_DOMAINS=1

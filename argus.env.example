# Argus settings. Copied to $ARGUS_HOME/config/argus.env by `./argus.sh init`.
# One KEY=value per line, no inline comments (the container runtime reads this
# file literally). Values may contain spaces. `argus.sh init` asks for the
# credentials below and writes them here for you. docs/INSTALL.md explains
# the optional integrations (Pi-hole, IntelOwl, syslog).

# ---- Dashboard and syslog listener --------------------------------------
ARGUS_HTTP_PORT=7080
# Dashboard access token, generated by `argus.sh init`. Everything except /api/health
# needs it; `argus.sh open` signs the browser in. Blank = no token (localhost only).
ARGUS_TOKEN=
# Extra Host names the dashboard answers to, besides 127.0.0.1, localhost and ::1.
# Leave blank unless you put Argus behind a reverse proxy.
ARGUS_ALLOWED_HOSTS=
ARGUS_SYSLOG=1
# 127.0.0.1 = only this Mac can send. Set to this Mac's LAN IP to accept
# syslog from routers, NAS boxes, other hosts.
ARGUS_SYSLOG_BIND=127.0.0.1
ARGUS_SYSLOG_UDP_PORT=5514
ARGUS_SYSLOG_TCP_PORT=5515
# What `argus.sh stream on` sends live from this Mac: slice (security events,
# < 1 event/s) or all (whole default-level unified log, gigabytes per day)
ARGUS_STREAM_MODE=slice
# Set to 0 by `argus.sh stream on` so CrowdSec does not see the same macOS
# events twice (live stream + 5-minute batches)
ARGUS_MACOS_TO_CROWDSEC=1

# ---- Container resources and hardening -----------------------------------
ARGUS_CPUS=2
ARGUS_MEMORY=2G
# 1 = read-only root filesystem; writes go only to /data, named volumes and tmpfs
ARGUS_READONLY_ROOT=1
# 1 = also mount /private/var/log, /Library/Logs and ~/Library/Logs read-only
ARGUS_MOUNT_HOST_LOGS=1

# ---- DNS -----------------------------------------------------------------
# Nameservers for the image builder VM (used when a build cannot resolve names)
ARGUS_BUILD_DNS=1.1.1.1 9.9.9.9
# Nameservers for the running container. Blank = runtime default (via the Mac).
# Set public resolvers if feed downloads fail with DNS errors; avoid your Pi-hole
# here, or Argus's own lookups show up in its query log and blocked threat
# domains resolve to 0.0.0.0.
ARGUS_DNS=

# ---- Collection ----------------------------------------------------------
# Root-owned drop folder the host collector writes and the container reads (read-only)
ARGUS_INBOX=/Users/Shared/Argus/inbox
# Hours of macOS events kept in the live analysis window
ARGUS_WINDOW_HOURS=24
# Days of converted logs / syslog spool kept inside the container
ARGUS_RETAIN_DAYS=7

# ---- CrowdSec (runs inside the container, detection only) -----------------
COLLECTIONS=crowdsecurity/linux crowdsecurity/iptables crowdsecurity/whitelist-good-actors
DISABLE_ONLINE_API=false
# Optional: enroll in the CrowdSec console (app.crowdsec.net)
ENROLL_KEY=
ENROLL_INSTANCE_NAME=argus
# Generated by `argus.sh init`; lets Argus read decisions + the community blocklist
BOUNCER_KEY_argus=

# ---- Pi-hole (v6 API) -----------------------------------------------------
# Blank URL = auto-detect a running container named *pihole* on the default network
PIHOLE_URL=
# Use an app password (Settings > Web interface / API > Configure app password)
PIHOLE_PASSWORD=
PIHOLE_POLL_SECONDS=120

# ---- IntelOwl ------------------------------------------------------------
# Blank = IntelOwl off. No auto-detect: set this explicitly (e.g. http://<intelowl-nginx IP>) once IntelOwl is reachable from the Argus network
INTELOWL_URL=
# IntelOwl > Account > API access > Generate token
INTELOWL_TOKEN=
INTELOWL_PLAYBOOK=FREE_TO_USE_ANALYZERS
INTELOWL_PUBLIC_URL=http://localhost:7001
# 1 = send flagged indicators automatically; 0 = manual lookups only
INTELOWL_AUTO=1
INTELOWL_DAILY_LIMIT=50

# ---- OSINT / threat-intel API keys (blank = provider off) ----------------
# Reputation-only hits on these owners' shared IPs (AbuseIPDB, OTX and similar), from
# connections made only by Apple-signed programs or a browser, are shown as low.
# High-severity feeds and CrowdSec local detections are never toned down. off = disable.
ARGUS_TRUSTED_CLOUDS=Apple,Google,Amazon,Microsoft,Cloudflare
# Indicators you've decided are fine: IPs, IPv4 CIDRs, domains (cover their subdomains)
# or AS numbers, separated by spaces or commas. They raise no findings. Entries
# added in the dashboard (Indicators > Allow list) are kept in the database.
ARGUS_ALLOW=
# Owner lookups use a local copy of the iptoasn.com table, refreshed weekly
# (one ~7 MB download; lookups never leave the Mac). 0 = off.
ARGUS_ASN=1

# abuse.ch (URLhaus, ThreatFox, Feodo): free key from https://auth.abuse.ch
ABUSECH_AUTH_KEY=
# CrowdSec CTI: free key from app.crowdsec.net > Settings > CTI API keys
CROWDSEC_CTI_KEY=
CROWDSEC_CTI_DAILY=30
ABUSEIPDB_KEY=
VT_API_KEY=
OTX_API_KEY=
GREYNOISE_KEY=
# urlscan.io search API key (free account): checks flagged domains/IPs for malicious scan verdicts.
URLSCAN_API_KEY=
URLSCAN_DAILY=300

# ---- Feeds and enrichment ------------------------------------------------
# Comma-separated feed ids to turn off, e.g. blocklist_de,cins
ARGUS_FEEDS_DISABLE=
# HaGeZi TIF size: tif.mini, tif.medium or tif (the full list needs more memory)
ARGUS_HAGEZI_LIST=tif.medium
# HaGeZi newly-registered-domain bands (each ~3M domains, ~25 MB RAM hashed). "none" turns them off.
ARGUS_NRD_LISTS=nrd7 nrd14-8
# RDAP domain-age checks per day (newly registered domain detection)
ARGUS_RDAP_DAILY=400
ARGUS_ENRICH_NEW_DOMAINS=1

# ---- endpoint telemetry (./argus.sh install-telemetry) --------------------
# Endpoint Security events eslogger subscribes to; events this macOS lacks are skipped.
#ARGUS_ES_EVENTS=exec btm_launch_item_add btm_launch_item_remove authentication xp_malware_detected xp_malware_remediated sudo su profile_add profile_remove tcc_modify openssh_login screensharing_attach login_login
# Little Snitch traffic history is read automatically when Little Snitch is installed and
# "Allow access via Terminal" is on. Flag uploads over this size to one destination per day.
ARGUS_UPLOAD_MB=500

# ---- network and devices ---------------------------------------------------
# Your DNS resolvers (e.g. Pi-hole or your VPN's DNS). When set, Argus alerts when the
# Mac's DNS goes anywhere else. Space-separated. Blank = just report what's in use.
ARGUS_EXPECTED_DNS=
# 1 = alert when the VPN (Mullvad or any connected VPN service / tunnel) is down.
ARGUS_EXPECT_VPN=0
# ---- findings ----------------------------------------------------------------
# Hour (0-23, local time) after which the daily digest is written; -1 = never.
ARGUS_DIGEST_HOUR=7
# Day the weekly edition is written (0 = Sunday … 6 = Saturday; -1 = never), after ARGUS_DIGEST_HOUR.
ARGUS_WEEKLY_DAY=1
# Sigma rules from SigmaHQ on Endpoint Security process launches: 0 = off.
ARGUS_SIGMA=1
# Rule ids or file names to skip, space-separated.
ARGUS_SIGMA_DISABLE=
# Your own Sigma rules: .yml files in $ARGUS_HOME/data/sigma/. Mute rules from the Endpoint tab.
# ---- alerts ------------------------------------------------------------------
# New high findings and stopped inputs raise an alert. macOS notifications are on by
# default (the com.argus.notify agent installed by ./argus.sh install-collector).
ARGUS_ALERT_MAC=1
# high (default) or medium: the lowest finding severity that alerts.
ARGUS_ALERT_SEV=high
# Alert when an input stops: fail (default), warn (also when it stalls) or off.
ARGUS_ALERT_HEALTH=fail
ARGUS_ALERT_MAX_PER_HOUR=6
# ntfy topic URL, e.g. https://ntfy.sh/<long-random-topic> or your own server. Anyone who
# knows a public ntfy.sh topic can read it, so use a long random name or a token.
ARGUS_NTFY_URL=
ARGUS_NTFY_TOKEN=
# Pushover application token and user key.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Any URL that accepts a JSON POST with "title" and "text" (Slack incoming webhooks work).
ARGUS_ALERT_WEBHOOK=
# Link opened from ntfy/Pushover alerts, e.g. http://fujin.local:7080/ (blank = none).
ARGUS_PUBLIC_URL=
# Container images are scanned once a day when grype or trivy is installed (brew install grype).
